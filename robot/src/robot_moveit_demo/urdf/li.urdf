<?xml version="1.0"?>
<robot name="robot_moveit_demo">
  
  <!-- ==================== 材质定义 ==================== -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <!-- ==================== 底座 (Base) ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ==================== 关节1: 腰部旋转 (Waist/Base Rotation) ==================== -->
  <joint name="joint1_waist" type="revolute">
    <parent link="base_link"/>
    <child link="link1_turntable"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <link name="link1_turntable">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ==================== 关节2: 肩部 (Shoulder) ==================== -->
  <joint name="joint2_shoulder" type="revolute">
    <parent link="link1_turntable"/>
    <child link="link2_upper_arm"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- 肩部舵机壳体 -->
  <link name="link2_upper_arm">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- 上臂连杆 -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.08"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.13"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- ==================== 关节3: 肘部 (Elbow) ==================== -->
  <joint name="joint3_elbow" type="revolute">
    <parent link="link2_upper_arm"/>
    <child link="link3_forearm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1.0"/>
  </joint>

  <link name="link3_forearm">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.045 0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- 前臂连杆 -->
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.035 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.045 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== 关节4: 腕部俯仰 (Wrist Pitch) ==================== -->
  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="link3_forearm"/>
    <child link="link4_wrist"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
  </joint>

  <link name="link4_wrist">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== 关节5: 腕部旋转 (Wrist Roll) ==================== -->
  <joint name="joint5_wrist_roll" type="revolute">
    <parent link="link4_wrist"/>
    <child link="link5_wrist_rotate"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="1.0"/>
  </joint>

  <link name="link5_wrist_rotate">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ==================== 关节6: 夹爪基座 (Gripper Base) ==================== -->
  <joint name="joint6_gripper_base" type="fixed">
    <parent link="link5_wrist_rotate"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.025 0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.025 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ==================== 左夹爪手指 (Left Finger) ==================== -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.015 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.025" effort="5" velocity="0.5"/>
  </joint>

  <link name="gripper_left_finger">
    <!-- 连杆部分 -->
    <visual>
      <origin xyz="0 0.01 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.02 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- 指尖 -->
    <visual>
      <origin xyz="0 0.005 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.01 0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0.008 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.02 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0.008 0.025" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== 右夹爪手指 (Right Finger) ==================== -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.015 0.02" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.025" effort="5" velocity="0.5"/>
  </joint>

  <link name="gripper_right_finger">
    <!-- 连杆部分 -->
    <visual>
      <origin xyz="0 -0.01 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.02 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- 指尖 -->
    <visual>
      <origin xyz="0 -0.005 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.01 0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 -0.008 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.02 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 -0.008 0.025" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== 摄像头 (Eye-in-Hand Camera) ==================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="link4_wrist"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0.01" rpy="0 0.3 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- 摄像头光学坐标系 -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- ==================== 末端执行器坐标系 (End Effector Frame) ==================== -->
  <joint name="ee_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="ee_link"/>

</robot>
