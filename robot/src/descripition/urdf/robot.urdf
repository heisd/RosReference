<?xml version="1.0"?>
<robot name="table_arm">

  <!-- base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!--@li--><cylinder radius="0.065" length="0.02"/> <!-- 直径13cm，高2cm -->
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!--@li--><cylinder radius="0.065" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- shoulder link (shoulder→elbow) -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/> <!-- raise from base top -->
      <geometry>
        <!--@li--><box size="0.03 0.03 0.13"/> <!-- 长约13cm -->
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.03 0.03 0.13"/>
      </geometry>
    </collision>
  </link>

  <!-- elbow link (elbow→wrist) -->
  <link name="elbow_link">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.025 0.025 0.065"/> <!-- 6.5cm -->
      </geometry>
      <material name="gray_dark">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.025 0.025 0.065"/>
      </geometry>
    </collision>
  </link>

  <!-- wrist link (wrist→gripper mount) -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.02 0.02 0.04"/> <!-- 4cm -->
      </geometry>
      <material name="gray_mid">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.02 0.02 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- gripper link (simple block; width 5cm) -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.05 0.02 0.04"/> <!-- 宽5cm，厚2cm，深4cm占位 -->
      </geometry>
      <material name="white">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <!--@li--><box size="0.05 0.02 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- joints (example revolute chain, adjust axes/origins as needed) -->
  <joint name="base_to_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/> <!-- at base top -->
    <axis xyz="0 0 1"/>
    <limit effort="5" velocity="2" lower="-3.14" upper="3.14"/>
  </joint>

  <joint name="shoulder_to_elbow" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="2" lower="-1.57" upper="1.57"/>
  </joint>

  <joint name="elbow_to_wrist" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="2" lower="-1.57" upper="1.57"/>
  </joint>

  <joint name="wrist_to_gripper" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

</robot>